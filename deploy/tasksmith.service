[Unit]
Description=TaskSmith Manual Run UI/API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/tasksmith/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=TASKSMITH_DATA_DIR=/opt/tasksmith/data
Environment=TASKSMITH_PI_AUTH_SOURCE=/home/deploy/.pi/agent
Environment=PI_SKIP_VERSION_CHECK=1
Environment=PI_TELEMETRY=0
ExecStartPre=/usr/local/bin/pnpm build
ExecStart=/usr/local/bin/node --import tsx src/server/index.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tasksmith /home/deploy/.pi

[Install]
WantedBy=multi-user.target
