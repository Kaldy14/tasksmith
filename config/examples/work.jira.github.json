{
  "description": "Work TaskSmith instance: Jira is the intake source, GitHub uses a separate work account/profile. Copy to the work Hetzner server and set TASKSMITH_CONFIG_PATH.",
  "sourceFlow": {
    "readinessLabel": "tasksmith",
    "pollIntervalSeconds": 60,
    "jiraRepoRouting": {
      "strategy": "label",
      "labels": {
        "vosime-admin": "vosime-admin",
        "core-hub": "core-hub"
      }
    }
  },
  "workflow": {
    "type": "single_task_sandcastle",
    "stages": [
      "plan",
      "implement",
      "deep_review",
      "fix",
      "deliver"
    ],
    "maxFixAttempts": 1,
    "maxCiFixAttempts": 1,
    "ciPollIntervalMs": 30000,
    "ciTimeoutMs": 900000,
    "deliveryMode": "ready_pr"
  },
  "defaultVerify": [
    {
      "name": "typecheck",
      "command": "pnpm typecheck",
      "timeoutMs": 180000
    },
    {
      "name": "lint",
      "command": "pnpm lint",
      "timeoutMs": 180000
    },
    {
      "name": "test",
      "command": "pnpm test",
      "timeoutMs": 300000
    }
  ],
  "repos": {
    "vosime-admin": {
      "displayName": "Vosime Admin",
      "gitUrl": "git@github.com:YOUR_ORG/vosime-admin.git",
      "defaultBranch": "main",
      "gitSshCommand": "ssh -i /home/deploy/.ssh/github-work -o IdentitiesOnly=yes",
      "gitProvider": {
        "type": "github",
        "owner": "YOUR_ORG",
        "repo": "vosime-admin",
        "ghConfigDir": "/home/deploy/.config/gh-work"
      },
      "issueProvider": {
        "type": "jira",
        "projectKey": "VOS",
        "jql": "project = VOS AND labels = tasksmith AND labels = vosime-admin AND status = 'Ready for AI'",
        "repoLabel": "vosime-admin"
      },
      "initCommands": [
        {
          "name": "install",
          "command": "pnpm install --frozen-lockfile",
          "timeoutMs": 300000
        }
      ]
    },
    "core-hub": {
      "displayName": "Core Hub",
      "gitUrl": "git@github.com:YOUR_ORG/core-hub.git",
      "defaultBranch": "main",
      "gitSshCommand": "ssh -i /home/deploy/.ssh/github-work -o IdentitiesOnly=yes",
      "gitProvider": {
        "type": "github",
        "owner": "YOUR_ORG",
        "repo": "core-hub",
        "ghConfigDir": "/home/deploy/.config/gh-work"
      },
      "issueProvider": {
        "type": "jira",
        "projectKey": "VOS",
        "jql": "project = VOS AND labels = tasksmith AND labels = core-hub AND status = 'Ready for AI'",
        "repoLabel": "core-hub"
      },
      "initCommands": [
        {
          "name": "install",
          "command": "pnpm install --frozen-lockfile",
          "timeoutMs": 300000
        }
      ]
    }
  }
}
