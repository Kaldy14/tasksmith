# Optional host/systemd environment additions for the TaskSmith app.
# Keep the real file under /opt/tasksmith/secrets/tasksmith.env or a root-owned systemd drop-in.
TASKSMITH_DATABASE_URL=postgres://tasksmith:replace-with-a-long-random-password@127.0.0.1:5432/tasksmith

# Enable Better Auth-backed UI/API auth. Generate with: openssl rand -base64 32
TASKSMITH_AUTH_ENABLED=1
TASKSMITH_AUTH_SECRET=replace-with-at-least-32-random-bytes
TASKSMITH_PUBLIC_URL=https://tasksmith.example.com
BETTER_AUTH_URL=https://tasksmith.example.com

# Bootstrap-only values for `pnpm auth:bootstrap-admin`; do not keep passwords in shell history.
# TASKSMITH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# TASKSMITH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-passphrase
# TASKSMITH_BOOTSTRAP_ADMIN_NAME=TaskSmith Admin
